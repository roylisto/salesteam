# Salesteam environment variables.
# Copy to .env and fill in real values:  cp .env.example .env

# --- Database (required) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salesteam
DB_POOL_SIZE=10
# CA certificate (PEM) used to verify the TLS connection to the database.
# Must be set for managed Postgres (e.g. Aiven). Keep the surrounding quotes;
# it may span multiple lines or be a single line with literal \n escapes.
DB_SSL_CA="-----BEGIN CERTIFICATE-----
...paste your project CA here...
-----END CERTIFICATE-----"

# --- App ---
NEXT_PUBLIC_APP_NAME=Salesteam
SESSION_COOKIE_NAME=salesteam_session
SESSION_TTL_DAYS=30
# Max password resets per member per calendar month (default 2; raise for testing).
PASSWORD_RESET_MONTHLY_LIMIT=2

# --- Object storage (S3-compatible / Cloudeka) ---
# Required: the app throws at startup if any of these are missing.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- SMTP (outgoing email) ---
# If SMTP_HOST is unset, outbound mail is logged to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Must use a sender domain authorized for the SMTP account.
SMTP_FROM=no-reply@example.com
